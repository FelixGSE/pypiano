{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "7 days",
  "semanticCommits": "enabled",
  "constraintsFiltering": "strict",
  "osvVulnerabilityAlerts": true,
  "automergeStrategy": "squash",
  "lockFileMaintenance": {
    "enabled": true,
    "description": "Weekly, in the Monday window of the other updates",
    "schedule": [
      "before 6am on monday"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in workflow variables, marked with a # renovate: comment on the line above",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Minor and patch updates, digest pins and lock file refreshes merge themselves once the required checks pass; major updates stay for review",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "pyproject.toml keeps minimum versions; the latest versions go into uv.lock",
      "matchManagers": [
        "pep621"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "uv, its build backend and the devcontainer's uv image move together",
      "matchPackageNames": [
        "uv",
        "uv_build",
        "ghcr.io/astral-sh/uv"
      ],
      "groupName": "uv"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Dev tools in one PR, unless it is a major update",
      "matchDepTypes": [
        "dependency-groups"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dev dependencies"
    },
    {
      "description": "Conventional PR titles for release-please. Updates only change uv.lock, which users of the library don't get, so none of them is a release (chore instead of the preset's fix for runtime dependencies)",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "chore"
    }
  ]
}
